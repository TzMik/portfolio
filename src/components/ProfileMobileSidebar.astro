---
const { yearsExperience } = Astro.props;
---

<div class="left-sidebar">
  <div class="row align-items-center mb-3">
    <div class="col-4 col-md-2 d-flex justify-content-end">
      <img
        class="me rounded-circle"
        src="/assets/images/portfolio.jpeg"
        alt="Me"
        width="110"
      />
    </div>
    <div class="col-8">
      <h2 class="h4">Ingeniero de software</h2>
      <h3 class="address">Guadalajara, México</h3>
      <h3 class="email">contacto@mikelcantero.dev</h3>
      <p class="d-none d-md-block mt-3">
        Llevo más de {yearsExperience} años trabajando en soluciones personalizadas
        para pequeñas, medianas y grandes empresas. Proponiendo soluciones tecnologicas
        creativas y escalables para mejorar y agilizar la operación de los negocios.
      </p>
    </div>
    <div class="d-none d-md-block col-md-2">
      <ul
        class="social-profile d-flex flex-column align-items-center flex-wrap justify-content-center"
      >
        <li>
          <a href="https://github.com/TzMik" target="_blank"
            ><i class="lab la-github"></i></a
          >
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/mikel-cantero-loi/"
            target="_blank"><i class="lab la-linkedin"></i></a
          >
        </li>
        <li>
          <a
            href="https://calendar.app.google/kEia5FjmbNAdXiT57"
            target="_blank"><i class="las la-calendar"></i></a
          >
        </li>
        <li>
          <a href="/#portfolio"><i class="las la-suitcase"></i></a>
        </li>
      </ul>
    </div>
  </div>
  <p class="d-block d-md-none text-center">
    Llevo más de {yearsExperience} años trabajando en soluciones personalizadas para
    pequeñas, medianas y grandes empresas. Proponiendo soluciones tecnologicas creativas
    y escalables para mejorar y agilizar la operación de los negocios.
  </p>

  <ul
    class="social-profile d-flex d-md-none align-items-center flex-wrap justify-content-center"
  >
    <li>
      <a href="https://github.com/TzMik" target="_blank"
        ><i class="lab la-github"></i></a
      >
    </li>
    <li>
      <a href="https://www.linkedin.com/in/mikel-cantero-loi/" target="_blank"
        ><i class="lab la-linkedin"></i></a
      >
    </li>
    <li>
      <a href="https://calendar.app.google/kEia5FjmbNAdXiT57" target="_blank"
        ><i class="las la-calendar"></i></a
      >
    </li>
    <li>
      <a href="/#portfolio"><i class="las la-suitcase"></i></a>
    </li>
  </ul>
  <div class="d-flex justify-content-center">
    <a href="mailto:contacto@mikelcantero.dev" class="theme-btn">
      <i class="las la-envelope"></i> Hablemos!
    </a>
  </div>
  <p class="copyright mt-2">&copy; {new Date().getFullYear()} Mikel Cantero.</p>
  <div class="sidebar-header d-flex d-md-none align-items-center justify-content-center">
    <img src="/assets/images/mc-logo.png" alt="Logo" width="100" />
  </div>
</div>
