---
const { imgSrc, alt, name } = Astro.props;
---
<div
	class="col-md-3 scroll-animation"
	data-animation="fade_from_left"
>
	<div class="skill">
		<div class="skill-inner">
			<img
				src={imgSrc}
				alt={alt}
                height="80"
			/>
		    <p class="name">{name}</p>
		</div>
	</div>
</div>
