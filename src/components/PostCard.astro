---
// Props: project (objeto del proyecto)
const { post, contentType } = Astro.props;

const now = new Date();

// Calcule si el proyecto es nuevo (publicado en los últimos 3 días)
const threeDaysInMs = 3 * 24 * 60 * 60 * 1000;
const isNew = now.getTime() - post.data.pub_date.getTime() <= threeDaysInMs;
---
<div class="col-md-6 col-lg-4 col-xl-3 p-3 position-relative" data-animation="fade_from_left">
    {isNew && (
    <span class="rounded-circle theme-btn p-2 position-absolute" title="Nuevo proyecto" style="z-index:2;top:5px;right:5px;">
            NEW
        </span>
    )}
    <div class="portfolio-item portfolio-half">
        <div class="portfolio-item-inner">
            <a href={`/blog/${post.slug}`}>
                <img
                    src={post.data.image}
                    alt={post.data.title ?? "Portfolio"}
                />
            </a>
        </div>
        <h2 class="project-listing-title">
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        </h2>
    </div>
</div>
