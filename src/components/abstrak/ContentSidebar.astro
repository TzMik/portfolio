---
import { calendarLink, socialLinks } from "../../data/MainInformation";
import { getSortedAndFilteredPosts } from "../../lib/blog-posts.js";

const blogPosts = await getSortedAndFilteredPosts();
const latestPosts = blogPosts.slice(0, 3);
---
<div class="axil-sidebar">
  <div class="widget widget-banner-ad">
    <a href={calendarLink} target="_blank">
      <div class="banner-cta">
        <button class="axil-btn btn-fill-primary">Trabajemos juntos</button>
      </div>
      <img src="/assets/images/banners/consultancy.webp" alt="banner" />
    </a>
  </div>
  <div class="widget widge-social-share">
    <div class="blog-share">
      <h5 class="title">Sígueme:</h5>
      <ul class="social-list list-unstyled">
        {
          socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank">
                <i class={link.icon} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="widget widget-recent-post">
    <h4 class="widget-title">Últimas publicaciones</h4>
    <div class="post-list-wrap">
      {
        latestPosts.map((post) => (
          <div class="single-post">
            <div class="post-thumbnail">
              <a href={`/blog/${post.slug}`}>
                <img src={post.data.image} alt={post.data.title} width="100" />
              </a>
            </div>
            <div class="post-content">
              <h6 class="title">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h6>
              <ul class="blog-meta list-unstyled">
                <li>
                  {post.data.pub_date.toLocaleDateString("es-ES", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </li>
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
