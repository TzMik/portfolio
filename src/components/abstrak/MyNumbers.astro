---
import { getProjectsAmount } from "../../lib/projects.js";
import { getPostsAmount } from "../../lib/blog-posts.js";
import { yearsOfExperience } from "../../data/MainInformation";

const numProjects = await getProjectsAmount();
const numPosts = await getPostsAmount();
---
<section style="padding: 60px 0; background: var(--secondary);">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle" style="color: rgba(255,255,255,0.7);">Mis números</span>
      <h2 class="section-title" style="color: #fff;">Información relevante</h2>
    </div>
    <div class="row justify-content-center g-4">
      <div class="col-lg-4 col-6">
        <div class="stat-item">
          <img src="/abstrak/assets/media/icon/icon-24.png" alt="Experiencia" class="stat-icon" loading="lazy" />
          <div class="stat-number">{yearsOfExperience}+</div>
          <div class="stat-label">Años de experiencia</div>
        </div>
      </div>
      <div class="col-lg-4 col-6">
        <div class="stat-item">
          <img src="/abstrak/assets/media/icon/icon-13.png" alt="Proyectos" class="stat-icon" loading="lazy" />
          <div class="stat-number">{numProjects}</div>
          <div class="stat-label">Proyectos</div>
        </div>
      </div>
      <div class="col-lg-4 col-6">
        <div class="stat-item">
          <img src="/abstrak/assets/media/icon/icon-14.png" alt="Posts" class="stat-icon" loading="lazy" />
          <div class="stat-number">{numPosts}</div>
          <div class="stat-label">Posts</div>
        </div>
      </div>
    </div>
  </div>
</section>
