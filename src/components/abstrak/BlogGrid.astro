---
const { post } = Astro.props;
---

<div class="col-md-6">
  <div class="project-grid project-style-2">
    <div class="thumbnail">
      <a href={"/blog/" + post.id}>
        <img src={typeof post.data.image === 'string' ? post.data.image : post.data.image?.src} alt="blog" />
      </a>
    </div>
    <div class="content">{post.data.title && <h3 class="title h6 bg-color-dark text-white px-3 py-2"><a href={"/blog/" + post.id}>{post.data.title}</a></h3>}</div>
  </div>
</div>
