---
const { post } = Astro.props;
---

<div class="col-md-6">
  <div class="project-grid project-style-2">
    <div class="thumbnail">
      <a href={"/projects/" + post.slug}>
        <img src={post.data.image} alt="project" />
      </a>
    </div>
    <div class="content">{post.data.title && <h3 class="title h6 bg-color-dark text-white px-3 py-2"><a href={"/projects/" + post.slug}>{post.data.title}</a></h3>}</div>
  </div>
</div>
