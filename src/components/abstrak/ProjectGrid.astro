---
interface Props {
  url: string;
  image: string | any;
  title?: string;
}

const { url, image, title } = Astro.props;
const imageSrc = typeof image === 'string' ? image : image?.src;
---

<div class="col-md-6">
  <div class="project-grid project-style-2">
    <div class="thumbnail">
      <a href={"/projects/" + url}>
        <img src={imageSrc} alt="project" />
      </a>
    </div>
    <div class="content">{title && <h3 class="title h4 bg-color-dark text-white px-3 py-2"><a href={"/projects/" + url}>{title}</a></h3>}</div>
  </div>
</div>
