---
interface Props {
  icon: string;
  count: number;
  title: string;
  symbol?: boolean;
}

const { icon, count, title, symbol = false } = Astro.props;
---
<div
  class="col-lg-4 col-6"
  data-sal="slide-up"
  data-sal-duration="800"
  data-sal-delay="100"
>
  <div class="counterup-progress active">
    <div class="icon">
      <img src={icon} alt={title} width="30" />
    </div>
    <div class="count-number h2">
      <span class="symbol">{symbol ? "+" : ""}</span>
      <span class="number count" data-count={count}>{count}</span>
    </div>
    <h6 class="title">{title}</h6>
  </div>
</div>
