---
import { slugify } from "../utils/slugify";
export interface Props {
  tags: string[];
  className?: string;
}
---
<ul class={Astro.props.className ?? "portfolio-categories d-none d-md-flex"}>
  {Astro.props.tags?.map((cat) => (
    <li>
      <a href={`/tags/${ slugify(cat) }`} class="text-decoration-none">
        {cat}
      </a>
    </li>
  ))}
</ul>
