---
import Layout from "./Layout.astro";
import "../styles/ProjectLayout.css";

const startDate = new Date(2018, 8, 1); // Mes 8 = septiembre (0-indexed)
const today = new Date();
const diffYears = today.getFullYear() - startDate.getFullYear();
const diffMonths = today.getMonth() - startDate.getMonth();
const diffDays = today.getDate() - startDate.getDate();

let yearsExperience = diffYears;
if (diffMonths < 0 || (diffMonths === 0 && diffDays < 0)) {
    yearsExperience--;
}
---

<Layout>
    <slot />
    <section class="container p-2 px-lg-5 mt-5">
        <div class="card p-3 bg-dark">
            <div class="row align-items-center">
                <div class="d-flex flex-column flex-md-row align-items-center col-12 col-lg-8 gap-3">
                    <div class="col-12 col-md-3 d-flex justify-content-center p-3">
                        <img
                            src="/assets/images/portfolio.jpeg"
                            class="rounded-circle"
                            alt="Mikel Cantero"
                            width="150"
                        />
                    </div>
                    <div class="col-12 col-md-9">
                        <div>
                            <div
                                class="section-header text-center text-md-start"
                            >
                                <h2 class="h4">Mikel Cantero</h2>
                                <h3 class="h6 mb-3">Ingeniero de Software</h3>
                                <p>
                                    Llevo más de {yearsExperience} años trabajando
                                    en soluciones personalizadas para pequeñas, medianas
                                    y grandes empresas. Proponiendo soluciones tecnologicas
                                    creativas y escalables para mejorar y agilizar
                                    la operación de los negocios.
                                </p>
                                <ul
                                    class="social-links d-flex justify-content-center justify-content-md-start gap-3 align-items-center"
                                >
                                    <li>
                                        <a
                                            href="/"
                                            target="_blank"
                                            ><i class="las la-home"></i></a
                                        >
                                    </li>
                                    <li>
                                        <a
                                            href="https://github.com/TzMik"
                                            target="_blank"
                                            ><i class="lab la-github"></i></a
                                        >
                                    </li>
                                    <li>
                                        <a
                                            href="https://www.linkedin.com/in/mikel-cantero-loi/"
                                            target="_blank"
                                            ><i class="lab la-linkedin"></i></a
                                        >
                                    </li>
                                    <li>
                                        <a
                                            href="https://calendar.app.google/kEia5FjmbNAdXiT57"
                                            target="_blank"
                                            ><i class="las la-calendar"></i></a
                                        >
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-4 d-flex justify-content-center">
                    <div>
                        <a
                            class="theme-btn"
                            href="mailto:contacto@mikelcantero.dev"
                        >
                            <i class="las la-envelope"></i> Hablemos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
