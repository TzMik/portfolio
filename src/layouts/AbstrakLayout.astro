---
import BackToTop from "../components/abstrak/BackToTop.astro";
import Header from "../components/abstrak/Header.astro";
import Footer from "../components/abstrak/Footer.astro";
import MyNumbers from "../components/abstrak/MyNumbers.astro";

import { socialLinks } from "../data/MainInformation";

const {
  title = "MikelCanteroDev",
  description = "Consultoría y desarrollo de software a medida para PYMES. Elimina el retrabajo y la ineficiencia operativa. Transforma tu empresa en crecimiento estratégico.",
  image = "/public/assets/images/portfolio.jpeg",
} = Astro.props;
---

<!doctype html>
<html class="no-js" lang="es">
  <head>
    <!-- Meta Data -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Mikel Cantero, consultoría software, desarrollo a medida, automatización PYMES, ingeniero de software, portfolio, eficiencia operativa" />
    <meta name="author" content="Mikel Cantero" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b0e14" />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Mikel Cantero - Ingeniero de Software" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <!-- Favicon -->
    <link
      rel="shortcut icon"
      type="image/x-icon"
      href="/assets/images/favicon.ico"
    />
    <link
      rel="stylesheet"
      href="/abstrak/assets/css/vendor/bootstrap.min.css"
    />
    <link rel="stylesheet" href="/abstrak/assets/css/vendor/font-awesome.css" />
    <link rel="stylesheet" href="/abstrak/assets/css/vendor/slick.css" />
    <link rel="stylesheet" href="/abstrak/assets/css/vendor/slick-theme.css" />
    <link rel="stylesheet" href="/abstrak/assets/css/vendor/sal.css" />
    <link
      rel="stylesheet"
      href="/abstrak/assets/css/vendor/magnific-popup.css"
    />
    <link
      rel="stylesheet"
      href="/abstrak/assets/css/vendor/green-audio-player.min.css"
    />
    <link
      rel="stylesheet"
      href="/abstrak/assets/css/vendor/odometer-theme-default.css"
    />

    <!-- Minimal Theme Stylesheet -->
    <link rel="stylesheet" href="/abstrak/assets/css/minimal.css" />
    <!-- Site Stylesheet (legacy) -->
    <link rel="stylesheet" href="/abstrak/assets/css/app.css" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HEJ2CCTQ8S"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-HEJ2CCTQ8S");
    </script>

    <!-- Adsense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4438825383617435"></script>
  </head>

  <body>
    <!--[if lte IE 9]>
    <p class="browserupgrade">You are using an <strong>outdated</strong> browser. Please <a href="https://browsehappy.com/">upgrade your browser</a> to improve your experience and security.</p>
  	<![endif]-->
    <BackToTop />

    <div id="main-wrapper" class="main-wrapper">
      <Header />

      <slot />

      <!--=====================================-->
      <!--=        Footer Area Start       	=-->
      <!--=====================================-->
      <MyNumbers />
      <Footer />
    </div>

    <!-- Jquery Js -->
    <script is:inline src="/abstrak/assets/js/vendor/jquery-3.7.1.min.js"
    ></script>
    <script is:inline src="/abstrak/assets/js/vendor/bootstrap.min.js"></script>
    <script is:inline src="/abstrak/assets/js/vendor/isotope.pkgd.min.js"
    ></script>
    <script is:inline src="/abstrak/assets/js/vendor/imagesloaded.pkgd.min.js"
    ></script>
    <script is:inline src="/abstrak/assets/js/vendor/odometer.min.js"></script>
    <script is:inline src="/abstrak/assets/js/vendor/jquery-appear.js"></script>
    <script is:inline src="/abstrak/assets/js/vendor/slick.min.js"></script>
    <script is:inline src="/abstrak/assets/js/vendor/sal.js"></script>
    <script
      is:inline
      src="/abstrak/assets/js/vendor/jquery.magnific-popup.min.js"></script>
    <script is:inline src="/abstrak/assets/js/vendor/js.cookie.js"></script>
    <script is:inline src="/abstrak/assets/js/vendor/jquery.style.switcher.js"
    ></script>
    <script is:inline src="/abstrak/assets/js/vendor/jquery.countdown.min.js"
    ></script>
    <script is:inline src="/abstrak/assets/js/vendor/tilt.js"></script>
    <script is:inline src="/abstrak/assets/js/vendor/green-audio-player.min.js"
    ></script>
    <script is:inline src="/abstrak/assets/js/vendor/jquery.nav.js"></script>

    <!-- Site Scripts -->
    <script is:inline src="/abstrak/assets/js/app.js"></script>
  </body>
</html>
