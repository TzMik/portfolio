---
interface Props {
	image?: string;
}

const { image } = Astro.props as Props;
const metaImage = image ?? "https://mikelcantero.com/assets/images/portfolio.jpeg";
const sections = [
	{
		url: "/",
		title: "Inicio",
		icon: "las la-home",
	},
	{
		url: "/projects",
		title: "Proyectos",
		icon: "las la-briefcase",
	},
	{
		url: "/#resume",
		title: "CV",
		icon: "las la-grip-vertical",
	},
	{
		url: "/#skills",
		title: "Habilidades",
		icon: "las la-stream",
	},
	{
		url: "/#technologies",
		title: "Tecnologías",
		icon: "las la-shapes",
	},
	{
		url: "/blog",
		title: "Blog",
		icon: "las la-pen-nib",
	},
	{
		url: "/#testimonial",
		title: "Reseñas",
		icon: "las la-comment",
	},
	{
		url: "/#contact",
		title: "Contacto",
		icon: "las la-envelope",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="canonical" href={Astro.url} />
		<!-- SEO Meta Tags -->
		<meta
			name="description"
			content="Portfolio de Mikel Cantero, Ingeniero de Software especializado en desarrollo web, proyectos, tecnologías y soluciones digitales."
		/>
		<meta
			name="keywords"
			content="Mikel Cantero, portfolio, ingeniero de software, desarrollo web, proyectos, tecnologías, reseñas, contacto"
		/>
		<meta name="author" content="Mikel Cantero" />
		<!-- Open Graph Meta Tags -->
		<meta
			property="og:title"
			content="Mikel Cantero - Ingeniero de Software"
		/>
		<meta
			property="og:description"
			content="Portfolio de Mikel Cantero, Ingeniero de Software especializado en desarrollo web y soluciones digitales."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://mikelcantero.com/" />
		<meta property="og:image" content={metaImage} />
		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta
			name="twitter:title"
			content="Mikel Cantero - Ingeniero de Software"
		/>
		<meta
			name="twitter:description"
			content="Portfolio de Mikel Cantero, Ingeniero de Software especializado en desarrollo web y soluciones digitales."
		/>
		<meta name="twitter:image" content={metaImage} />
		<title>Mikel Cantero - Ingeniero de Software</title>
		<link
			rel="icon"
			type="image/x-icon"
			href="/assets/images/favicon.ico"
		/>

		<!-- Font -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>

		<!-- Stylesheet -->
		<link
			rel="stylesheet"
			href="https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css"
		/>
		<link href="/assets/css/bootstrap.min.css" rel="stylesheet" />
		<link rel="stylesheet" href="/assets/css/owl.carousel.min.css" />
		<link rel="stylesheet" href="/assets/css/owl.theme.default.min.css" />
		<link rel="stylesheet" href="/assets/css/animate.min.css" />
		<link rel="stylesheet" href="/assets/css/smooth-scrollbar.css" />
		<link rel="stylesheet" href="/assets/css/lightbox.min.css" />

		<link rel="stylesheet" href="/assets/css/style.css" />
		<link rel="stylesheet" href="/assets/css/responsive.css" />
		<!-- Google tag (gtag.js) -->
		<script
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-HEJ2CCTQ8S"
		></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-HEJ2CCTQ8S");
		</script>
	</head>
	<body class="home5-page">
		<!--<video class="body-overlay" muted autoplay loop>
			<source src="/assets/images/video5.mp4" type="video/mp4" />
		</video>

		<div class="page-loader">
			<div class="bounceball"></div>
		</div> -->

		<span class="icon-menu">
			<span class="bar"></span>
			<span class="bar"></span>
		</span>

		<div class="responsive-sidebar-menu">
			<div class="overlay"></div>
			<div class="sidebar-menu-inner">
				<div class="menu-wrap">
					<p>Menú</p>
					<ul class="menu scroll-nav-responsive d-flex">
						{
							sections.map((section) => (
								<li>
									<a class="scroll-to" href={section.url}>
										<i class={section.icon} />
										<span>{section.title}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div class="sidebar-social">
					<p>Social</p>
					<ul class="social-links d-flex align-items-center">
						<li>
							<a href="/"><i class="lab la-github"></i></a>
						</li>
						<li>
							<a href="/"><i class="lab la-linkedin"></i></a>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<ul class="menu scroll-nav d-flex">
			{
				sections.map((section) => (
					<li>
						<a class="scroll-to" href={section.url}>
							<span>{section.title}</span>
							<i class={section.icon} />
						</a>
					</li>
				))
			}
		</ul>

		<slot />

		<script src="/assets/js/jquery.js" is:inline></script>
		<script src="/assets/js/bootstrap.bundle.min.js" is:inline></script>
		<script src="/assets/js/owl.carousel.js" is:inline></script>
		<script src="/assets/js/gsap.min.js" is:inline></script>
		<script src="/assets/js/ScrollTrigger.min.js" is:inline></script>
		<script src="/assets/js/ScrollToPlugin.min.js" is:inline></script>
		<script src="/assets/js/lightbox.min.js" is:inline></script>

		<script src="/assets/js/main.js" is:inline></script>
		<script src="/assets/js/ajax-form.js" is:inline></script>
		<script src="/assets/js/color.js" is:inline></script>
	</body>
</html>
