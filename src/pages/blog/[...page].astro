---
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";
import {
  createStaticPathsForPosts,
  POSTS_PER_PAGE,
} from "../../lib/pagination.js";
import { getSortedAndFilteredPosts } from "../../lib/blog-posts.js";
import WorkTogether from "../../components/abstrak/WorkTogether.astro";

const allPosts = await getSortedAndFilteredPosts();

const { page = 1 } = Astro.params;
const currentPage = Number(page);
const totalPages = Math.max(Math.ceil(allPosts.length / POSTS_PER_PAGE), 1);

if (currentPage < 1 || currentPage > totalPages) {
  return Astro.response(new Response("Página no encontrada", { status: 404 }));
}

const start = (currentPage - 1) * POSTS_PER_PAGE;
const items = allPosts.slice(start, start + POSTS_PER_PAGE);

const pageUrl = (n: number) => (n === 1 ? "/blog" : `/blog/${n}`);

const postsJson = allPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  image: typeof post.data.image === "string" ? post.data.image : post.data.image?.src || "",
}));

export async function getStaticPaths() {
  return createStaticPathsForPosts(POSTS_PER_PAGE);
}
---

<AbstrakLayout title="Blog | MikelCanteroDev">
  <div class="page-header">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-minimal">
          <li class="breadcrumb-item"><a href="/">Inicio</a></li>
          <li class="breadcrumb-item active">Blog</li>
        </ol>
      </nav>
      <h1>Blog</h1>
      <p class="text-secondary fs-5 mb-0">Artículos sobre desarrollo de software, arquitectura y automatización.</p>
    </div>
  </div>

  <section class="section section-alt">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <!-- Search -->
          <div class="mb-4">
            <div class="search-form">
              <input type="text" id="blog-search" placeholder="Buscar por título..." />
              <button type="button" aria-label="Buscar"><i class="fas fa-search"></i></button>
            </div>
          </div>

          <!-- Posts Grid -->
          <div class="row g-4" id="blog-posts-container">
            {items.map((post) => {
              const imgSrc = typeof post.data.image === 'string' ? post.data.image : post.data.image?.src;
              return (
                <div class="col-md-6">
                  <div class="card-custom">
                    <div class="card-thumb">
                      <a href={"/blog/" + post.id}>
                        <img src={imgSrc || ""} alt={post.data.title} loading="lazy" />
                      </a>
                    </div>
                    <div class="card-body">
                      <h3 class="card-title">
                        <a href={"/blog/" + post.id}>{post.data.title}</a>
                      </h3>
                      {post.data.description && <p class="text-secondary mt-2 mb-0" style="font-size: 14px; line-height: 1.5;">{post.data.description}</p>}
                      <a href={"/blog/" + post.id} class="read-more mt-2 d-inline-block">Leer más <i class="fas fa-arrow-right"></i></a>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>

          <!-- Pagination -->
          <nav class="pagination-minimal d-flex justify-content-center mt-5" id="blog-pagination" aria-label="Paginación del blog">
            <ul class="pagination">
              <li class={`page-item ${currentPage <= 1 ? 'disabled' : ''}`}>
                <a class="page-link" href={currentPage > 1 ? pageUrl(currentPage - 1) : '#'} aria-label="Anterior">
                  <i class="fas fa-arrow-left"></i>
                </a>
              </li>
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
                <li class={`page-item ${n === currentPage ? 'active' : ''}`}>
                  <a class="page-link" href={pageUrl(n)}>{n}</a>
                </li>
              ))}
              <li class={`page-item ${currentPage >= totalPages ? 'disabled' : ''}`}>
                <a class="page-link" href={currentPage < totalPages ? pageUrl(currentPage + 1) : '#'} aria-label="Siguiente">
                  <i class="fas fa-arrow-right"></i>
                </a>
              </li>
            </ul>
          </nav>
        </div>

        <div class="col-lg-4">
          <ContentSidebar />
        </div>
      </div>
    </div>
  </section>

  <WorkTogether />

  <script define:vars={{ postsJson }}>
    document.addEventListener("DOMContentLoaded", () => {
      const searchInput = document.getElementById("blog-search");
      const postsContainer = document.getElementById("blog-posts-container");
      const pagination = document.getElementById("blog-pagination");

      if (!searchInput || !postsContainer) return;

      const originalHTML = postsContainer.innerHTML;
      const originalPaginationDisplay = pagination ? pagination.style.display : "";

      searchInput.addEventListener("input", (e) => {
        const query = e.target.value.trim().toLowerCase();

        if (query === "") {
          postsContainer.innerHTML = originalHTML;
          if (pagination) {
            pagination.style.display = originalPaginationDisplay;
          }
          return;
        }

        const filtered = postsJson.filter((post) =>
          post.title.toLowerCase().includes(query)
        );

        if (pagination) {
          pagination.style.display = "none";
        }

        if (filtered.length === 0) {
          postsContainer.innerHTML = `
            <div class="col-12 text-center py-5">
              <h5 class="text-secondary">No se encontraron publicaciones que coincidan con "${e.target.value}".</h5>
            </div>
          `;
          return;
        }

        postsContainer.innerHTML = filtered
          .map(
            (post) => `
          <div class="col-md-6">
            <div class="card-custom">
              <div class="card-thumb">
                <a href="/blog/${post.id}">
                  <img src="${post.image}" alt="${post.title}" loading="lazy" />
                </a>
              </div>
              <div class="card-body">
                <h3 class="card-title">
                  <a href="/blog/${post.id}">${post.title}</a>
                </h3>
                <a href="/blog/${post.id}" class="read-more mt-2 d-inline-block">Leer m&aacute;s <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
          </div>
        `
          )
          .join("");
      });
    });
  </script>
</AbstrakLayout>
