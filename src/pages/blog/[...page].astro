---
// src/pages/blog/[...page].astro
import AbstrakProjectLayout from "../../layouts/AbstrakLayout.astro";
import BlogGrid from "../../components/abstrak/BlogGrid.astro";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";
import "../../styles/AbstrakProjectLayout.css";

// Importa PAGE_SIZE y las funciones de ayuda
import {
  createStaticPathsForPosts,
  POSTS_PER_PAGE,
} from "../../lib/pagination.js";
import { getSortedAndFilteredPosts } from "../../lib/blog-posts.js";
import WorkTogether from "../../components/abstrak/WorkTogether.astro";

// Llama a la función correcta para obtener las publicaciones
const allPosts = await getSortedAndFilteredPosts();

const { page = 1 } = Astro.params;
const currentPage = Number(page);
const totalPages = Math.max(Math.ceil(allPosts.length / POSTS_PER_PAGE), 1);

console.log(currentPage);
if (currentPage < 1 || currentPage > totalPages) {
  return Astro.response(new Response("Página no encontrada", { status: 404 }));
}

const start = (currentPage - 1) * POSTS_PER_PAGE;
const items = allPosts.slice(start, start + POSTS_PER_PAGE);

const pageUrl = (n) => (n === 1 ? "/blog" : `/blog/${n}`);

//getStaticPaths ahora es mucho más simple y usa la función importada
export async function getStaticPaths() {
  return createStaticPathsForPosts(POSTS_PER_PAGE);
}
---

<AbstrakProjectLayout title="Blog | MikelCanteroDev">
  <div class="breadcrum-area">
    <div class="container">
      <div class="breadcrumb">
        <ul class="list-unstyled">
          <li><a href="/">Inicio</a></li>
          <li class="active">Blog</li>
        </ul>
        <h1 class="title h2">Blog</h1>
      </div>
    </div>
    <ul class="shape-group-8 list-unstyled">
      <li
        class="shape shape-1"
        data-sal="slide-right"
        data-sal-duration="500"
        data-sal-delay="100"
      >
        <img src="/abstrak/assets/media/others/bubble-9.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-2"
        data-sal="slide-left"
        data-sal-duration="500"
        data-sal-delay="200"
      >
        <img src="/abstrak/assets/media/others/bubble-10.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-3"
        data-sal="slide-up"
        data-sal-duration="500"
        data-sal-delay="300"
      >
        <img src="/abstrak/assets/media/others/line-4.png" alt="Line" />
      </li>
    </ul>
  </div>

  <section class="section-padding-equal">
    <div class="container">
      <div class="row row-40">
        <div class="col-lg-8">
          <div class="row row-40">
            {items.map((post) => <BlogGrid post={post} />)}
          </div>
          <div class="pagination">
            <ul>
              <!-- Previous Button -->
              {
                currentPage > 1 && (
                  <li>
                    <a
                      class="prev page-numbers"
                      href={pageUrl(currentPage - 1)}
                    >
                      <i class="fal fa-arrow-left" />
                    </a>
                  </li>
                )
              }

              <!-- Page Numbers -->
              {
                Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
                  <li>
                    <a
                      href={pageUrl(n)}
                      class={`page-numbers ${n === currentPage ? "current" : ""}`}
                    >
                      {n}
                    </a>
                  </li>
                ))
              }

              <!-- Next Button -->
              {
                currentPage < totalPages && (
                  <li>
                    <a
                      class="next page-numbers"
                      href={pageUrl(currentPage + 1)}
                    >
                      <i class="fal fa-arrow-right" />
                    </a>
                  </li>
                )
              }
            </ul>
          </div>
        </div>
        <div class="col-lg-4">
          <ContentSidebar />
        </div>
      </div>
    </div>
  </section>
  <WorkTogether />
</AbstrakProjectLayout>
