---
// src/pages/blog/[...page].astro
import AbstrakProjectLayout from "../../layouts/AbstrakLayout.astro";
import BlogGrid from "../../components/abstrak/BlogGrid.astro";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";
import "../../styles/AbstrakProjectLayout.css";

// Importa PAGE_SIZE y las funciones de ayuda
import {
  createStaticPathsForPosts,
  POSTS_PER_PAGE,
} from "../../lib/pagination.js";
import { getSortedAndFilteredPosts } from "../../lib/blog-posts.js";
import WorkTogether from "../../components/abstrak/WorkTogether.astro";

// Llama a la función correcta para obtener las publicaciones
const allPosts = await getSortedAndFilteredPosts();

const { page = 1 } = Astro.params;
const currentPage = Number(page);
const totalPages = Math.max(Math.ceil(allPosts.length / POSTS_PER_PAGE), 1);

console.log(currentPage);
if (currentPage < 1 || currentPage > totalPages) {
  return Astro.response(new Response("Página no encontrada", { status: 404 }));
}

const start = (currentPage - 1) * POSTS_PER_PAGE;
const items = allPosts.slice(start, start + POSTS_PER_PAGE);

const pageUrl = (n) => (n === 1 ? "/blog" : `/blog/${n}`);

const postsJson = allPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  image: typeof post.data.image === "string" ? post.data.image : post.data.image?.src || "",
}));

//getStaticPaths ahora es mucho más simple y usa la función importada
export async function getStaticPaths() {
  return createStaticPathsForPosts(POSTS_PER_PAGE);
}
---

<AbstrakProjectLayout title="Blog | MikelCanteroDev">
  <div class="breadcrum-area">
    <div class="container">
      <div class="breadcrumb">
        <ul class="list-unstyled">
          <li><a href="/">Inicio</a></li>
          <li class="active">Blog</li>
        </ul>
        <h1 class="title h2">Blog</h1>
      </div>
    </div>
    <ul class="shape-group-8 list-unstyled">
      <li
        class="shape shape-1"
        data-sal="slide-right"
        data-sal-duration="500"
        data-sal-delay="100"
      >
        <img src="/abstrak/assets/media/others/bubble-9.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-2"
        data-sal="slide-left"
        data-sal-duration="500"
        data-sal-delay="200"
      >
        <img src="/abstrak/assets/media/others/bubble-10.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-3"
        data-sal="slide-up"
        data-sal-duration="500"
        data-sal-delay="300"
      >
        <img src="/abstrak/assets/media/others/line-4.png" alt="Line" />
      </li>
    </ul>
  </div>

  <section class="section-padding-equal">
    <div class="container">
      <div class="row row-40">
        <div class="col-lg-8">
          <div class="row row-40" id="blog-posts-container">
            {items.map((post) => <BlogGrid post={post} />)}
          </div>
          <div class="pagination" id="blog-pagination">
            <ul>
              <!-- Previous Button -->
              {
                currentPage > 1 && (
                  <li>
                    <a
                      class="prev page-numbers"
                      href={pageUrl(currentPage - 1)}
                    >
                      <i class="fal fa-arrow-left" />
                    </a>
                  </li>
                )
              }

              <!-- Page Numbers -->
              {
                Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
                  <li>
                    <a
                      href={pageUrl(n)}
                      class={`page-numbers ${n === currentPage ? "current" : ""}`}
                    >
                      {n}
                    </a>
                  </li>
                ))
              }

              <!-- Next Button -->
              {
                currentPage < totalPages && (
                  <li>
                    <a
                      class="next page-numbers"
                      href={pageUrl(currentPage + 1)}
                    >
                      <i class="fal fa-arrow-right" />
                    </a>
                  </li>
                )
              }
            </ul>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="widget widget-search">
            <h4 class="widget-title">Buscar</h4>
            <div class="blog-search">
              <form action="#" class="blog-search-form" onsubmit="return false;">
                <input type="text" id="blog-search" placeholder="Buscar por título..." />
                <button class="search-button" type="button"><i class="fal fa-search"></i></button>
              </form>
            </div>
          </div>
          <ContentSidebar />
        </div>
      </div>
    </div>
  </section>
  <WorkTogether />

  <script define:vars={{ postsJson }}>
    document.addEventListener("DOMContentLoaded", () => {
      const searchInput = document.getElementById("blog-search");
      const postsContainer = document.getElementById("blog-posts-container");
      const pagination = document.getElementById("blog-pagination");

      if (!searchInput || !postsContainer) return;

      // Guardamos el HTML original de la página y su paginación
      const originalHTML = postsContainer.innerHTML;
      const originalPaginationDisplay = pagination ? pagination.style.display : "";

      searchInput.addEventListener("input", (e) => {
        const query = e.target.value.trim().toLowerCase();

        if (query === "") {
          // Restaurar estado original
          postsContainer.innerHTML = originalHTML;
          if (pagination) {
            pagination.style.display = originalPaginationDisplay;
          }
          return;
        }

        // Filtrar posts por título
        const filtered = postsJson.filter((post) =>
          post.title.toLowerCase().includes(query)
        );

        // Ocultar paginación durante la búsqueda
        if (pagination) {
          pagination.style.display = "none";
        }

        if (filtered.length === 0) {
          postsContainer.innerHTML = `
            <div class="col-12 text-center py-5">
              <h5 class="text-muted">No se encontraron publicaciones que coincidan con "${e.target.value}".</h5>
            </div>
          `;
          return;
        }

        // Renderizar los resultados filtrados
        postsContainer.innerHTML = filtered
          .map(
            (post) => `
          <div class="col-md-6">
            <div class="project-grid project-style-2">
              <div class="thumbnail">
                <a href="/blog/${post.id}">
                  <img src="${post.image}" alt="blog" />
                </a>
              </div>
              <div class="content">
                <h3 class="title h6 bg-color-dark text-white px-3 py-2">
                  <a href="/blog/${post.id}">${post.title}</a>
                </h3>
              </div>
            </div>
          </div>
        `
          )
          .join("");
      });
    });
  </script>
</AbstrakProjectLayout>
