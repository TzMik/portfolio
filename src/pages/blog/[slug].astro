---
import { getCollection } from "astro:content";
import type { BlogPostSchema } from "../../content.config";
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";
import BlogPostRichSnippet from "../../components/BlogPostRichSnippet.astro";

export async function getStaticPaths() {
  const now = new Date();
  const blogPosts = await getCollection("blogPosts", ({ data }) => {
    return data.draft == false && data.pub_date <= now;
  });
  return blogPosts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const post: BlogPostSchema = entry.data;
import { render } from "astro:content";
const { Content } = await render(entry);
---

<AbstrakLayout title={post.title + " - Blog | MikelCanteroDev"} description={post.description} image={typeof post.image === 'string' ? post.image : post.image?.src}>
  <div class="page-header">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-minimal">
          <li class="breadcrumb-item"><a href="/">Inicio</a></li>
          <li class="breadcrumb-item"><a href="/blog">Blog</a></li>
          <li class="breadcrumb-item active">{post.title}</li>
        </ol>
      </nav>
      <h1>{post.title}</h1>
      <div class="post-meta">
        <span><i class="fas fa-user"></i>Mikel Cantero</span>
        <span><i class="fas fa-calendar-alt"></i>{post.pub_date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        {post.tags && post.tags.map((tag) => (
          <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag-pill">{tag}</a>
        ))}
      </div>
    </div>
  </div>

  <section class="section section-alt">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          {post.image && (
            <img
              src={typeof post.image === 'string' ? post.image : post.image?.src}
              alt={post.title}
              style="width: 100%; border-radius: var(--radius-lg); margin-bottom: 32px;"
              loading="lazy"
            />
          )}
          <div class="post-content">
            <Content />
          </div>
        </div>
        <div class="col-lg-4">
          <ContentSidebar />
        </div>
      </div>
    </div>
  </section>

  <BlogPostRichSnippet title={post.title} description={post.description} image={post.image} tags={post.tags} date={post.pub_date} />
</AbstrakLayout>
