---
import { calendarLink } from "../../data/MainInformation";
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import { getCollection, render } from "astro:content";
import type { LearningPathSchema } from "../../content.config";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";

export async function getStaticPaths() {
  const paths = await getCollection("learningPaths");
  return paths.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const path: LearningPathSchema = entry.data;
const { Content } = await render(entry);

if (path.draft === true) {
  return new Response(null, { status: 404 });
}
---

<AbstrakLayout title={`${path.title} - Ruta de Aprendizaje | MikelCanteroDev`} description={path.description}>
  <div class="page-header">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-minimal">
          <li class="breadcrumb-item"><a href="/">Inicio</a></li>
          <li class="breadcrumb-item"><a href="/learning-paths">Rutas</a></li>
          <li class="breadcrumb-item active">{path.title}</li>
        </ol>
      </nav>
      <h1>{path.title}</h1>
      <p class="text-secondary fs-5">{path.description}</p>
      {path.tags && (
        <div class="mt-2">
          {path.tags.map((tag) => (
            <span class="tag-pill">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </div>

  <section class="section section-alt">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <h2 class="mb-4" style="font-size: 22px; font-weight: 700;">
            <i class="fas fa-list-ol me-2" style="color: var(--brand);"></i>Recursos y Lecturas de la Ruta
          </h2>

          {path.links && path.links.length > 0 ? (
            <div>
              {path.links.map((link, index) => {
                const isExternal = link.url.startsWith("http");
                const target = isExternal ? "_blank" : "_self";
                const rel = isExternal ? "noopener noreferrer" : undefined;
                return (
                  <div class="link-card">
                    <div class="link-number">{String(index + 1).padStart(2, '0')}</div>
                    <div class="link-info">
                      <h4>
                        <a href={link.url} target={target} rel={rel}>
                          {link.title}
                          {isExternal && <i class="fas fa-external-link-alt ms-2" style="font-size: 12px; color: var(--text-light);"></i>}
                        </a>
                      </h4>
                      {link.description && <p>{link.description}</p>}
                    </div>
                    <a href={link.url} target={target} rel={rel} class="btn btn-outline-brand btn-sm flex-shrink-0">
                      {isExternal ? 'Visitar' : 'Leer'} <i class="fas fa-chevron-right ms-1"></i>
                    </a>
                  </div>
                );
              })}
            </div>
          ) : (
            <div class="text-center py-5" style="background: #fff; border-radius: var(--radius-lg); padding: 48px;">
              <h4>No hay enlaces disponibles para esta ruta.</h4>
              <p class="text-secondary">Próximamente se añadirán recursos recomendados.</p>
            </div>
          )}
        </div>

        <div class="col-lg-4">
          <div class="sidebar-card">
            <h4><i class="fas fa-info-circle me-2" style="color: var(--brand);"></i>Sobre esta Ruta</h4>
            <div style="font-size: 15px; line-height: 1.6; color: var(--text-secondary);">
              <Content />
              <a href={calendarLink} target="_blank" class="btn btn-brand btn-sm w-100 mt-3"><i class="fas fa-calendar-alt me-1"></i>Agenda una llamada</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</AbstrakLayout>
