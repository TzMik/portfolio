---
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import { getCollection } from "astro:content";
import WorkTogether from "../../components/abstrak/WorkTogether.astro";

const learningPaths = await getCollection("learningPaths", ({ data }) => {
  return data.draft !== true;
});
---

<AbstrakLayout title="Rutas de Aprendizaje | MikelCanteroDev" description="Aprende desarrollo frontend, backend, arquitectura de software y mejores prácticas con estas guías y enlaces seleccionados.">
  <div class="page-header">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-minimal">
          <li class="breadcrumb-item"><a href="/">Inicio</a></li>
          <li class="breadcrumb-item active">Rutas de Aprendizaje</li>
        </ol>
      </nav>
      <div class="row align-items-center g-4">
        <div class="col-lg-6">
          <h1>Rutas de Aprendizaje</h1>
          <p class="text-secondary fs-5 mb-0">Guías de estudio estructuradas y colecciones de recursos clave para dominar el desarrollo de software moderno.</p>
        </div>
        <div class="col-lg-6 text-center">
          <img src="/assets/images/portfolio.jpeg" alt="Mikel Cantero" width="200" style="border-radius: var(--radius-lg);" loading="lazy" />
        </div>
      </div>
    </div>
  </div>

  <section class="section section-alt">
    <div class="container">
      {learningPaths.length === 0 ? (
        <div class="text-center py-5">
          <h3>No hay rutas de aprendizaje disponibles en este momento.</h3>
          <p class="text-secondary">Vuelve pronto para ver nuevo contenido.</p>
        </div>
      ) : (
        <div class="row g-4">
          {learningPaths.map((path) => {
            let iconClass = "fa-laptop-code";
            if (path.data.tags?.includes("backend")) iconClass = "fa-server";
            else if (path.data.tags?.includes("arquitectura") || path.data.tags?.includes("solid")) iconClass = "fa-project-diagram";
            else if (path.data.tags?.includes("frontend")) iconClass = "fa-desktop";

            return (
              <div class="col-lg-4 col-md-6">
                <div class="learning-card">
                  <div class="card-icon"><i class={`fas ${iconClass}`}></i></div>
                  <h3><a href={`/learning-paths/${path.id}`} style="color: inherit; text-decoration: none;">{path.data.title}</a></h3>
                  <p>{path.data.description}</p>
                  {path.data.tags && (
                    <div class="mb-3">
                      {path.data.tags.map((tag) => (
                        <span class="tag-pill">#{tag}</span>
                      ))}
                    </div>
                  )}
                  <a href={`/learning-paths/${path.id}`} class="btn btn-outline-brand btn-sm">Ver ruta</a>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <WorkTogether />
</AbstrakLayout>
