---
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";
import { yearsOfExperience } from "../../data/MainInformation";
import "../../styles/AbstrakProjectLayout.css";
import { getSortedProjects } from "../../lib/projects.js";
import ProjectGrid from "../../components/abstrak/ProjectGrid.astro";
import WorkTogether from "../../components/abstrak/WorkTogether.astro";

let topProjects = await getSortedProjects();
topProjects = topProjects.slice(0, 2);
---

<AbstrakLayout title="Sobre Mí | MikelCanteroDev">
  <div class="breadcrum-area breadcrumb-banner">
    <div class="container">
      <div class="section-heading heading-left">
        <h1 class="title h2">
          De la Estrategia al Código: Senior Backend Engineer con Visión de
          Arquitectura
        </h1>
      </div>
      <div class="banner-thumbnail thumbnail-4">
        <img
          src="/assets/images/banners/main.webp"
          width="400"
          alt="Illustration"
        />
      </div>
    </div>
    <ul class="shape-group-8 list-unstyled">
      <li
        class="shape shape-1"
        data-sal="slide-right"
        data-sal-duration="500"
        data-sal-delay="100"
      >
        <img src="/abstrak/assets/media/others/bubble-9.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-2"
        data-sal="slide-left"
        data-sal-duration="500"
        data-sal-delay="200"
      >
        <img src="/abstrak/assets/media/others/bubble-22.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-3"
        data-sal="slide-up"
        data-sal-duration="500"
        data-sal-delay="300"
      >
        <img src="/abstrak/assets/media/others/line-4.png" alt="Line" />
      </li>
    </ul>
  </div>
  <section class="section section-padding case-study-featured-area">
    <div class="container">
      <div class="row row-40">
        <div class="col-lg-8" id="project-content">
          <p>
            <b
              >Ingeniero de Software con más de {yearsOfExperience} años de experiencia</b
            >, especializado en la <b
              >construcción de sistemas escalables y arquitectura de alto
              rendimiento</b
            >.
          </p>
          <p>
            Tras años liderando departamentos tecnológicos y definiendo la
            estrategia técnica para empresas como Fonsecantero, he decidido
            regresar a mi núcleo profesional: la ingeniería <b>backend</b>. Mi
            trayectoria como <b>CTO y Tech Lead</b> me otorga una ventaja competitiva
            única: no solo escribo código, sino que <b
              >entiendo cómo este debe sostener el crecimiento real de un
              negocio</b
            > y la estabilidad operativa de un sistema.
          </p>
          <h2 class="title">Mi enfoque técnico</h2>
          <p>
            Me especializo en el desarrollo de infraestructuras robustas, con un
            dominio avanzado de Node.js, Laravel (PHP) y Python. Mi experiencia
            incluye:
          </p>
          <ul>
            <li>
              <b>Arquitectura Escalable:</b> Diseño de soluciones que han soportado
              infraestructuras con más de un millón de usuarios concurrentes y volúmenes
              masivos de datos.
            </li>
            <li>
              <b>Optimización de Procesos:</b> Implementación de sistemas de automatización
              y web scraping que escalaron operativamente de 3 a más de 50 países.
            </li>
            <li>
              <b>Cultura de Ingeniería:</b> Como ex-líder de equipos de hasta 13 desarrolladores
              , aplico una mentalidad de mejora continua, revisión de código orientada
              a buenas prácticas y reducción de deuda técnica.
            </li>
          </ul>
          <h2 class="title">Mi valor diferencial</h2>
          <p>
            Mi formación como <b>Ingeniero Informático</b> complementada con un <b
              >MBA</b
            > me permite ser el puente entre los requerimientos complejos de negocio
            y la ejecución técnica impecable. Actualmente, estoy enfocado en profundizar
            en la orquestación de sistemas modernos que prioricen la eficiencia y
            la mantenibilidad.
          </p>
          <h2 class="title">Últimos proyectos</h2>
          <div class="row row-45">
            {
              topProjects.map((project) => (
                <ProjectGrid
                  url={project.slug}
                  image={project.data.image || ""}
                  title=""
                />
              ))
            }
          </div>
        </div>
        <div class="col-lg-4">
          <ContentSidebar />
        </div>
      </div>
    </div>
  </section>
  <WorkTogether />
</AbstrakLayout>
