---
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";
import { calendarLink, yearsOfExperience } from "../../data/MainInformation";
import {
  experience,
  education,
  languages,
  skills,
} from "../../data/CvInformation";
import "../../styles/AbstrakProjectLayout.css";
import { getSortedProjects } from "../../lib/projects.js";
import WorkTogether from "../../components/abstrak/WorkTogether.astro";

let topProjects = await getSortedProjects();
topProjects = topProjects.slice(0, 2);
---

<AbstrakLayout title="Sobre Mí | MikelCanteroDev">
  <div class="page-header">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-minimal">
          <li class="breadcrumb-item"><a href="/">Inicio</a></li>
          <li class="breadcrumb-item active">Sobre mí</li>
        </ol>
      </nav>
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <h1>Mikel Cantero, Ingeniero Informático</h1>
          <p class="text-secondary fs-5">
            Tengo más de { yearsOfExperience } años trabajando en la Industria del Software. Lo que más me 
            apasiona es desarrollar soluciones a medida para clientes. Mi éxito es que mi solución
            te ahorre tiempo, dinero y te permita dormir mejor por las noches.
          </p>
        </div>
        <div class="col-lg-6 text-center">
          <img src="/assets/images/portfolio.jpeg" width="200" alt="Mikel Cantero" style="border-radius: var(--radius-lg);" loading="lazy" />
        </div>
      </div>
    </div>
  </div>

  <section class="section section-alt">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8" id="project-content">
          <div class="post-content">
            <p>
              A lo largo de mi carrera he tenido la oportunidad de ayudar a decenas de clientes desarrollando diversas <b>soluciones digitales</b>: desde sistemas <b>ERP y CRM</b> hasta plataformas de <b>comercio electrónico e integraciones con servicios externos</b> para centralizar la información en un solo lugar.
            </p>
            <p>
              Decir que soy un apasionado de la tecnología sería algo obvio. Especialmente al inicio, creo que muchos ingenieros nos obsesionamos con las herramientas, pero a veces olvidamos algo fundamental: <b>la tecnología es solo un medio para un fin</b>. Con los años, mi enfoque ha evolucionado; pasé de obsesionarme con la tecnología en sí a <b>concentrarme en el problema de negocio</b> que esa tecnología debe resolver.
            </p>
            <p>
              Hoy en día, lo que más me satisface es <b>tomar un problema</b> o dolor real del cliente, <b>diseñar una solución a medida</b> ajustada a su presupuesto y ver cómo ese desarrollo le <b>ahorra tiempo, reduce costos o simplemente le facilita la vida</b>. Eso es lo que realmente le da sentido a mi trabajo.
            </p>
            <p>
              Si has llegado hasta aquí, probablemente quieras conocer más sobre mi trayectoria. A continuación te comparto mi experiencia y trasfondo profesional.
            </p>
            <!-- ============ EXPERIENCIA ============ -->
            <div class="cv-block">
              <h2><i class="fas fa-briefcase"></i> Experiencia</h2>
              <div class="cv-timeline">
                {experience.map((job) => (
                  <div class={`cv-item${job.current ? " is-current" : ""}`}>
                    <div class="cv-head">
                      <h3 class="cv-role">{job.role}</h3>
                      <span class="cv-period">
                        {job.start} — {job.end ?? "Presente"}
                      </span>
                    </div>
                    <div class="cv-org">
                      <i class="fas fa-building"></i>
                      {job.url ? (
                        <a href={job.url} target="_blank" rel="noopener noreferrer">
                          {job.company}
                        </a>
                      ) : (
                        job.company
                      )}
                      {job.location && <span class="cv-loc">· {job.location}</span>}
                    </div>
                    <p class="cv-desc">{job.description}</p>
                    {job.stack && job.stack.length > 0 && (
                      <ul class="cv-tags">
                        {job.stack.map((tech) => (
                          <li>{tech}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </div>

            <!-- ============ EDUCACIÓN ============ -->
            <div class="cv-block">
              <h2><i class="fas fa-graduation-cap"></i> Educación</h2>
              <div class="cv-timeline">
                {education.map((item) => (
                  <div class="cv-item">
                    <div class="cv-head">
                      <h3 class="cv-role">{item.degree}</h3>
                      <span class="cv-period">
                        {item.start}
                        {item.end ? ` — ${item.end}` : ""}
                      </span>
                    </div>
                    <div class="cv-org">
                      <i class="fas fa-university"></i>
                      {item.school}
                      {item.location && <span class="cv-loc">· {item.location}</span>}
                    </div>
                    {item.description && <p class="cv-desc">{item.description}</p>}
                  </div>
                ))}
              </div>
            </div>

            <!-- ============ IDIOMAS ============ -->
            <div class="cv-block">
              <h2><i class="fas fa-language"></i> Idiomas</h2>
              <div class="cv-langs">
                {languages.map((lang) => (
                  <div class="cv-lang">
                    <div class="cv-lang-head">
                      <span class="cv-lang-name">{lang.name}</span>
                      <span class="cv-lang-level">{lang.level}</span>
                    </div>
                    <div class="cv-bar">
                      <span style={`width: ${lang.percent}%`}></span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- ============ TECNOLOGÍAS ============ -->
            <div class="cv-block mb-5">
              <h2><i class="fas fa-code"></i> Tecnologías</h2>
              <div class="cv-skills">
                {skills.map((group) => (
                  <div class="cv-skill-card">
                    <h3>
                      <i class={group.icon}></i>
                      {group.category}
                    </h3>
                    <div class="cv-chips">
                      {group.items.map((item) => (
                        <span class="cv-chip">{item}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <blockquote>
              <span style="font-size: 18px; font-weight: 600; display: block; margin-bottom: 16px;">¿Hay algo en lo que te pueda ayudar?</span>
              <a href={calendarLink} target="_blank" class="btn btn-brand">Agenda una reunión conmigo</a>
            </blockquote>
          </div>
        </div>
        <div class="col-lg-4">
          <ContentSidebar />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Portafolio</span>
        <h2 class="section-title">Proyectos Destacados</h2>
      </div>
      <div class="row g-4 justify-content-center">
        {
          topProjects.map((project) => {
            const imgSrc = typeof project.data.image === 'string' ? project.data.image : project.data.image?.src;
            return (
              <div class="col-md-6">
                <div class="card-custom">
                  <div class="card-thumb">
                    <a href={"/projects/" + project.id}>
                      <img src={imgSrc || ""} alt={project.data.title} loading="lazy" />
                    </a>
                  </div>
                  <div class="card-body">
                    <h3 class="card-title">
                      <a href={"/projects/" + project.id}>{project.data.title}</a>
                    </h3>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <WorkTogether />
</AbstrakLayout>

<style>
  /* ============ CV / Timeline ============ */
  #project-content .cv-block {
    margin-top: 44px;
  }

  #project-content .cv-block > h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
  }

  #project-content .cv-block > h2 i {
    font-size: 0.8em;
    color: var(--brand);
  }

  /* --- Timeline (experiencia y educación) --- */
  #project-content .cv-timeline {
    position: relative;
  }

  #project-content .cv-timeline::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border);
    border-radius: 2px;
  }

  #project-content .cv-item {
    position: relative;
    padding-left: 40px;
    padding-bottom: 30px;
  }

  #project-content .cv-item:last-child {
    padding-bottom: 4px;
  }

  #project-content .cv-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--secondary);
    border: 3px solid var(--bg-alt);
    box-shadow: 0 0 0 1px var(--border);
  }

  #project-content .cv-item.is-current::before {
    background: var(--brand);
    box-shadow: 0 0 0 1px var(--brand), 0 0 0 5px var(--brand-light);
  }

  #project-content .cv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
  }

  #project-content .cv-role {
    font-size: 17px;
    font-weight: 700;
    margin: 0;
    color: var(--text);
  }

  #project-content .cv-period {
    font-size: 12px;
    font-weight: 600;
    color: var(--secondary);
    background: var(--secondary-light);
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }

  #project-content .cv-item.is-current .cv-period {
    color: var(--brand-hover);
    background: var(--brand-light);
  }

  #project-content .cv-org {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 6px;
  }

  #project-content .cv-org i {
    color: var(--brand);
    font-size: 13px;
    width: 14px;
    text-align: center;
  }

  #project-content .cv-org .cv-loc {
    color: var(--text-light);
    font-weight: 400;
  }

  #project-content .cv-org a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--transition), border-color var(--transition);
  }

  #project-content .cv-org a:hover,
  #project-content .cv-org a:focus-visible {
    color: var(--brand);
    border-bottom-color: var(--brand);
  }

  #project-content .cv-desc {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 10px 0 0;
  }

  #project-content .cv-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 14px 0 0;
  }

  #project-content .cv-tags li {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--white);
    border: 1px solid var(--border-light);
    padding: 2px 10px;
    border-radius: 999px;
  }

  /* --- Idiomas --- */
  #project-content .cv-langs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px 32px;
  }

  #project-content .cv-lang-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  #project-content .cv-lang-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  #project-content .cv-lang-level {
    font-size: 13px;
    color: var(--text-secondary);
  }

  #project-content .cv-bar {
    height: 8px;
    background: var(--border-light);
    border-radius: 999px;
    overflow: hidden;
  }

  #project-content .cv-bar span {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--brand), var(--secondary));
  }

  /* --- Tecnologías --- */
  #project-content .cv-skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
  }

  #project-content .cv-skill-card {
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 18px;
    transition: box-shadow var(--transition), transform var(--transition);
  }

  #project-content .cv-skill-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  #project-content .cv-skill-card h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 14px;
    color: var(--text);
  }

  #project-content .cv-skill-card h3 i {
    color: var(--brand);
    font-size: 13px;
  }

  #project-content .cv-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  #project-content .cv-chip {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text);
    background: var(--bg-alt);
    border: 1px solid var(--border-light);
    padding: 3px 11px;
    border-radius: 8px;
    transition: color var(--transition), border-color var(--transition);
  }

  #project-content .cv-chip:hover {
    color: var(--brand);
    border-color: var(--brand);
  }
</style>
