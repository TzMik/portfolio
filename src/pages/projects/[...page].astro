---
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import ProjectListElem from "../../components/abstrak/ProjectListElem.astro";
import { getSortedProjects } from "../../lib/projects.js";
import WorkTogether from "../../components/abstrak/WorkTogether.astro";
import { yearsOfExperience } from "../../data/MainInformation";

export async function getStaticPaths({ paginate }) {
  const allProjects = await getSortedProjects();
  // Generate pages from our array of projects, with 6 items per page
  return paginate(allProjects, { pageSize: 6 });
}

const { page } = Astro.props;
---

<AbstrakLayout title="Proyectos | MikelCanteroDev">
  <div class="breadcrum-area">
    <div class="container">
      <div class="breadcrumb">
        <ul class="list-unstyled">
          <li><a href="/">Inicio</a></li>
          <li class="active">Proyectos</li>
        </ul>
      </div>
      <div class="row">
        <div class="col-md-6">
          <h1 class="title h2">Portafolio</h1>
          <p>
            Cada proyecto aquí expuesto es el resultado de unir <b>{yearsOfExperience} años de experiencia</b> técnica con una mentalidad <b>orientada a resultados</b>. Mi objetivo es simple: que tu <b>tecnología sea una inversión que maximice la rentabilidad</b>, no un gasto que genere problemas.
          </p>
        </div>
        <div class="col-md-6 d-flex justify-content-center">
          <img
            class="paralax-image custom-shape"
            src="/assets/images/portfolio.jpeg"
            alt="Illustration"
            width="300"
          />
        </div>
      </div>
      <div class="section-heading heading-left"></div>
      <div class="banner-thumbnail">
      </div>
    </div>
    <ul class="shape-group-8 list-unstyled">
      <li
        class="shape shape-1"
        data-sal="slide-right"
        data-sal-duration="500"
        data-sal-delay="100"
      >
        <img src="/abstrak/assets/media/others/bubble-9.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-2"
        data-sal="slide-left"
        data-sal-duration="500"
        data-sal-delay="200"
      >
        <img src="/abstrak/assets/media/others/bubble-20.png" alt="Bubble" />
      </li>
    </ul>
  </div>
  <section class="section py-3">
    <div class="container">
      <div class="axil-isotope-wrapper">
        <div class="isotope-button isotope-project-btn">
          <button data-filter="*" class="is-checked"
            ><span class="filter-text">Todos</span></button
          >
        </div>
        <div class="row isotope-list">
          {
            page.data.map((project) => (
              <ProjectListElem
                image={project.data.image}
                title={project.data.title}
                url={project.id}
              />
            ))
          }
        </div>
        <div class="pagination justify-content-center mt--20">
          <ul>
            <li>
              {
                page.url.prev ? (
                  <a class="prev page-numbers" href={page.url.prev}>
                    <i class="fal fa-arrow-left" />
                  </a>
                ) : null
              }
            </li>

            {
              Array.from({ length: page.lastPage }, (_, i) => i + 1).map(
                (pageNum) => (
                  <li>
                    <a
                      href={
                        pageNum === 1 ? "/projects" : `/projects/${pageNum}`
                      }
                      class={`page-numbers ${page.currentPage === pageNum ? "current" : ""}`}
                    >
                      {pageNum}
                    </a>
                  </li>
                ),
              )
            }

            <li>
              {
                page.url.next ? (
                  <a class="next page-numbers" href={page.url.next}>
                    <i class="fal fa-arrow-right" />
                  </a>
                ) : null
              }
            </li>
          </ul>
        </div>
      </div>
    </div>
    <ul class="shape-group-7 list-unstyled">
      <li class="shape shape-1">
        <img src="/abstrak/assets/media/others/circle-2.png" alt="circle" />
      </li>
      <li class="shape shape-2">
        <img src="/abstrak/assets/media/others/bubble-2.png" alt="Line" />
      </li>
      <li class="shape shape-3">
        <img src="/abstrak/assets/media/others/bubble-1.png" alt="Line" />
      </li>
    </ul>
  </section>
  <WorkTogether />
</AbstrakLayout>
