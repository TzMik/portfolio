---
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import { getSortedProjects } from "../../lib/projects.js";
import WorkTogether from "../../components/abstrak/WorkTogether.astro";
import { yearsOfExperience } from "../../data/MainInformation";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allProjects = await getSortedProjects();
  return paginate(allProjects, { pageSize: 9 });
}

const { page }: any = Astro.props;
---

<AbstrakLayout title="Proyectos | MikelCanteroDev">
  <div class="page-header">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-minimal">
          <li class="breadcrumb-item"><a href="/">Inicio</a></li>
          <li class="breadcrumb-item active">Proyectos</li>
        </ol>
      </nav>
      <div class="row align-items-center g-4">
        <h1>Portafolio</h1>
        <p class="text-secondary mb-0 fs-5">
          Cada proyecto aquí expuesto es el resultado de unir <strong>{yearsOfExperience} años de experiencia</strong> técnica con una mentalidad <strong>orientada a resultados</strong>.
        </p>
      </div>
    </div>
  </div>

  <section class="section section-alt">
    <div class="container">
      <div class="row g-4">
        {
          page.data.map((project: any) => {
            const imgSrc = typeof project.data.image === 'string' ? project.data.image : project.data.image?.src;
            return (
              <div class="col-xl-4 col-md-6">
                <div class="card-custom">
                  <div class="card-thumb">
                    <a href={"/projects/" + project.id}>
                      <img src={imgSrc || ""} alt={project.data.title} loading="lazy" />
                    </a>
                  </div>
                  <div class="card-body">
                    <h3 class="card-title">
                      <a href={"/projects/" + project.id}>{project.data.title}</a>
                    </h3>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Pagination -->
      <nav class="pagination-minimal d-flex justify-content-center" aria-label="Paginación de proyectos">
        <ul class="pagination">
          <li class="page-item disabled">
            <a class="page-link" href={page.url.prev || '#'} aria-label="Anterior">
              <i class="fas fa-arrow-left"></i>
            </a>
          </li>
          {
            Array.from({ length: page.lastPage }, (_, i) => i + 1).map(
              (pageNum) => (
                <li class={`page-item ${page.currentPage === pageNum ? 'active' : ''}`}>
                  <a class="page-link" href={pageNum === 1 ? "/projects" : `/projects/${pageNum}`}>
                    {pageNum}
                  </a>
                </li>
              ),
            )
          }
          <li class="page-item">
            <a class="page-link" href={page.url.next || '#'} aria-label="Siguiente">
              <i class="fas fa-arrow-right"></i>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </section>

  <WorkTogether />
</AbstrakLayout>
