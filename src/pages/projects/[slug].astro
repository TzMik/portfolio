---
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import { getCollection } from "astro:content";
import type { ProjectSchema } from "../../content/config";
import "../../styles/AbstrakProjectLayout.css";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const project: ProjectSchema = entry.data;
const { Content } = await entry.render();

if (project.draft !== false) {
  return new Response(null, { status: 404 });
}

---

<AbstrakLayout>
  <div class="breadcrum-area breadcrumb-banner single-breadcrumb">
    <div class="container">
      <div class="breadcrumb">
        <ul class="list-unstyled">
          <li><a href="/">Inicio</a></li>
          <li><a href="/projects">Proyectos</a></li>
          <li class="active">{project.title}</li>
        </ul>
      </div>
      <div class="row align-items-center">
        <div class="col-lg-6">
          <div class="section-heading heading-left">
            <h1 class="title h2">{project.title}</h1>
            <p>
              {project.description}
            </p>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="banner-thumbnail">
            <img
              class="paralax-image"
              src={project.image}
              alt="Illustration"
              width="500"
            />
          </div>
        </div>
      </div>
    </div>
    <ul class="shape-group-8 list-unstyled">
      <li
        class="shape shape-1"
        data-sal="slide-right"
        data-sal-duration="500"
        data-sal-delay="100"
      >
        <img src="/abstrak/assets/media/others/bubble-9.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-2"
        data-sal="slide-left"
        data-sal-duration="500"
        data-sal-delay="200"
      >
        <img src="/abstrak/assets/media/others/bubble-20.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-3"
        data-sal="slide-up"
        data-sal-duration="500"
        data-sal-delay="300"
      >
        <img src="/abstrak/assets/media/others/line-4.png" alt="Line" />
      </li>
    </ul>
  </div>
  <section class="section-padding single-portfolio-area">
    <div class="container">
      <div class="row">
        <div class="col-lg-7" id="project-content">
          <Content />
        </div>
        <div class="col-lg-4 offset-lg-1">
          <ContentSidebar />
        </div>
      </div>
    </div>
  </section>
</AbstrakLayout>
