---
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import { getCollection } from "astro:content";
import type { ProjectSchema } from "../../content.config";
import "../../styles/AbstrakProjectLayout.css";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";
import SoftwareAppRichSnippet from "../../components/SoftwareAppRichSnippet.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const project: ProjectSchema = entry.data;
import { render } from "astro:content";
const { Content } = await render(entry);

if (project.draft !== false) {
  return new Response(null, { status: 404 });
}
---

<AbstrakLayout title={project.title + " - Proyectos | MikelCanteroDev"} description={project.description} image={project.image}>
  <div class="page-header">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-minimal">
          <li class="breadcrumb-item"><a href="/">Inicio</a></li>
          <li class="breadcrumb-item"><a href="/projects">Proyectos</a></li>
          <li class="breadcrumb-item active">{project.title}</li>
        </ol>
      </nav>
      <div class="row align-items-center g-4">
        <div class="col-lg-6">
          <h1>{project.title}</h1>
          <p class="text-secondary fs-5">{project.description}</p>
        </div>
        <div class="col-lg-6 text-center">
          {project.image && (
            <img
              src={typeof project.image === 'string' ? project.image : project.image?.src}
              alt={project.title}
              width="500"
              style="border-radius: var(--radius-lg); max-width: 100%;"
              loading="lazy"
            />
          )}
        </div>
      </div>
    </div>
  </div>

  <section class="section section-alt">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8" id="project-content">
          <div class="post-content">
            <Content />
          </div>
        </div>
        <div class="col-lg-4">
          <ContentSidebar />
        </div>
      </div>
    </div>
  </section>

  <SoftwareAppRichSnippet title={project.title} description={project.description} image={project.image} tags={project.tags} date={project.pub_date} />
</AbstrakLayout>
