---
import { getCollection } from "astro:content";
import type { ProjectSchema } from "../../content/config";
import ProjectLayout from "../../layouts/ProjectLayout.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const project: ProjectSchema = entry.data;
const { Content } = await entry.render();
---

<ProjectLayout>
    <main class="drake-main">
        <div id="smooth-wrapper">
            <div id="smooth-content">
                <article class="container">
                    {
                        project.image && (
                            <div
                                class="project-hero mt-2"
                                style={`background-image: url('${project.image}'); background-size: cover; background-position: center; position: relative; width: 100%; min-height: 300px; display: flex; align-items: center; justify-content: center; border-radius: 1rem;`}
                            >
                                <div
                                    class="project-hero-title"
                                    style="position: absolute; z-index: 2; width: 100%; text-align: center;"
                                >
                                    <h1 style="color: white; text-shadow: 0 2px 8px rgba(0,0,0,0.7); margin: 0;">
                                        {project.title}
                                    </h1>
                                </div>
                                <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.35); border-radius: 1rem;" />
                            </div>
                        )
                    }

                    <div style="margin-bottom: 1rem;">
                        <ul class="portfolio-categories">
                            {
                                project.tags?.map((cat) => (
                                    <li>
                                        <a href="/">{cat}</a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div class="project-content">
                        <Content />
                    </div>
                </article>
            </div>
        </div>
    </main>
</ProjectLayout>
