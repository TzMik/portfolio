---
import { getCollection } from "astro:content";
import type { BlogPostSchema } from "../../content/config";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ProjectRichSnippet from "../../components/ProjectRichSnippet.astro";
import { slugify } from "../../utils/slugify.js";

export async function getStaticPaths() {
    const now = new Date();

    const blogPosts = await getCollection("blog", ({ data }) => {
        return data.draft == false && data.pub_date <= now;
    });

    return blogPosts.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const post: BlogPostSchema = entry.data;
const { Content } = await entry.render();
---

<ProjectLayout image={post.image}>
    <main class="drake-main">
        <div id="smooth-wrapper">
            <div id="smooth-content">
                <article class="container">
                    {
                        post.image && (
                            <div
                                class="project-hero mt-2"
                                style={`background-image: url('${post.image}'); background-size: cover; background-position: center; position: relative; width: 100%; min-height: 300px; display: flex; align-items: center; justify-content: center; border-radius: 1rem;`}
                            >
                                <div
                                    class="project-hero-title"
                                    style="position: absolute; z-index: 2; width: 100%; text-align: center;"
                                >
                                    <h1 style="color: var(--primary_color); text-shadow: 0 2px 8px rgba(0,0,0,0.7); margin: 0;font-weight: 800;">
                                        {post.title}
                                    </h1>
                                </div>
                                <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.75); border-radius: 1rem;" />
                            </div>
                        )
                    }

                    <div style="margin-bottom: 1rem;">
                        <ul class="portfolio-categories">
                            {
                                post.tags?.map((tag) => (
                                    <li>
                                        <a href={`/tags/${slugify(tag)}`}>
                                            {tag}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div class="project-content">
                        <Content />
                    </div>
                </article>
            </div>
        </div>
    </main>
    <ProjectRichSnippet
        title={post.title}
        description={post.description}
        image={post.image}
        tags={post.tags}
        date={post.pub_date}
    />
</ProjectLayout>
