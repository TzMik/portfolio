            <li><strong>Correo electrónico:</strong> <a href="mailto:contacto@mikelcantero.dev">contacto@mikelcantero.dev</a></li>
            <li><strong>WhatsApp / Teléfono:</strong> <a href="https://wa.me/523326462099" target="_blank" rel="noopener noreferrer">+52 33 2646 2099</a></li>
          </ul>
        </div>
        <div class="col-lg-4">
          <ContentSidebar />
        </div>
      </div>
    </div>
  </section>
</AbstrakLayout>
