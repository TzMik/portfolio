---
import ProfileSidebar from "../components/ProfileSidebar.astro";
import Skill from "../components/Skill.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const startDate = new Date(2018, 8, 1); // Mes 8 = septiembre (0-indexed)
const today = new Date();
const diffYears = today.getFullYear() - startDate.getFullYear();
const diffMonths = today.getMonth() - startDate.getMonth();
const diffDays = today.getDate() - startDate.getDate();

let yearsExperience = diffYears;
if (diffMonths < 0 || (diffMonths === 0 && diffDays < 0)) {
	yearsExperience--;
}

const projects = await getCollection("projects");
const numProjects = projects.length;

const topProjects = projects
	.filter((project) => project.data.top_project === true)
	.sort((a, b) => {
		const dateA = new Date(a.data.pub_date || 0).getTime();
		const dateB = new Date(b.data.pub_date || 0).getTime();
		return dateB - dateA;
	})
	.slice(0, 3);
