---
import AbstrakLayout from "../layouts/AbstrakLayout.astro";
import { getSortedProjects } from "../lib/projects.js";
import { getSortedAndFilteredPosts } from "../lib/blog-posts.js";
import { getCollection } from "astro:content";
import { socialLinks, calendarLink, yearsOfExperience } from "../data/MainInformation";
import ReviewRichSnippet from "../components/ReviewRichSnippet.astro";

const siteUrl = "https://mikelcantero.dev";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Mikel Cantero - Ingeniero de Software",
  url: siteUrl,
  description: "Consultoría y desarrollo de software a medida para PYMES. Elimina el retrabajo y la ineficiencia operativa.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteUrl}/search?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mikel Cantero",
  givenName: "Mikel",
  familyName: "Cantero",
  jobTitle: "Ingeniero de Software",
  description: `Ingeniero de Software con más de ${yearsOfExperience} años de experiencia especializado en desarrollo web, automatización de procesos y software a medida para PYMES.`,
  image: `${siteUrl}/assets/images/portfolio.jpeg`,
  url: siteUrl,
  sameAs: socialLinks.map((l) => l.href),
  email: "contacto@mikelcantero.dev",
  telephone: "+523326462099",
};

const websiteJson = JSON.stringify(websiteSchema);
const personJson = JSON.stringify(personSchema);

const brands = [
  { image: "/assets/images/brands/pinkup.png", brand: "PinkUP Cosmetics" },
  { image: "/assets/images/brands/GOC.png", brand: "GOC Make Up" },
  { image: "/assets/images/brands/Intermoda.png", brand: "Intermoda" },
  { image: "/assets/images/brands/Beserva.png", brand: "Beserva" },
  { image: "/assets/images/brands/cloe.png", brand: "Cloe" },
  { image: "/assets/images/brands/Instituto-jalisciense-de-cancerologia.png", brand: "Instituto Jalisciense de Cancerología" },
  { image: "/assets/images/brands/vax.png", brand: "Vax Solutions" },
  { image: "/assets/images/brands/idoo.png", brand: "Idoo" },
];

let topProjects = await getSortedProjects();
topProjects = topProjects.slice(0, 2);

let testimonials = await getCollection("testimonials");
testimonials = testimonials.sort(() => Math.random() - 0.5);
testimonials = testimonials.slice(0, 3);

const blogPosts = await getSortedAndFilteredPosts();
const latestPosts = blogPosts.slice(0, 2);
---

<AbstrakLayout>
  <script is:inline type="application/ld+json" set:html={websiteJson} />
  <script is:inline type="application/ld+json" set:html={personJson} />
  <!-- Hero -->
  <section class="hero-section">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <span class="hero-subtitle">MIKEL CANTERO — INGENIERO DE SOFTWARE</span>
          <h1 class="hero-title">Desarrollo Software que te ahorra tiempo y dinero</h1>
          <p class="hero-desc">
            Digitalizo y automatizo procesos con la intención de hacer más eficiente tu trabajo,
            evitando perderte en las operaciones del día a día, permitiéndote así enfocarte en lo 
            verdaderamente importante: la estrategia.
          </p>
          <div class="d-flex flex-wrap gap-3">
            <a target="_blank" href={calendarLink} class="btn btn-brand btn-lg">Trabajemos juntos</a>
            <a href="#about" class="btn btn-outline-brand btn-lg">Sobre mí</a>
          </div>
        </div>
        <div class="col-lg-6 d-flex justify-content-center justify-content-lg-end hero-img-col">
          <img src="/assets/images/portfolio.jpeg" alt="Mikel Cantero" loading="lazy" style="max-width: 200px; border-radius: var(--radius-lg);" />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section" style="background: var(--secondary); color: #fff;">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle" style="color: rgba(255,255,255,0.7);">Portafolio</span>
        <h2 class="section-title" style="color: #fff;">Últimos proyectos</h2>
        <p class="section-desc" style="color: rgba(255,255,255,0.75);">Aquí encontrarás los últimos proyectos en los que he participado.</p>
      </div>
      <div class="row g-4 justify-content-center">
        {
          topProjects.map((project) => {
            const imgSrc = typeof project.data.image === 'string' ? project.data.image : project.data.image?.src;
            return (
              <div class="col-md-6 col-lg-5">
                <div class="card-custom">
                  <div class="card-thumb">
                    <a href={"/projects/" + project.id}>
                      <img src={imgSrc || ""} alt={project.data.title} loading="lazy" />
                    </a>
                  </div>
                  <div class="card-body">
                    <h3 class="card-title">
                      <a href={"/projects/" + project.id}>{project.data.title}</a>
                    </h3>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
      <div class="text-center mt-5">
        <a href="/projects" class="btn btn-outline-light btn-accent-hover">Ver casos de éxito</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section" id="about">
    <div class="container">
      <div class="row g-5 align-items-start">
        <div class="col-lg-6">
          <span class="section-subtitle">Sobre mí</span>
          <h2 class="section-title">Un poco sobre mí</h2>
          <p class="mb-4">
            Soy un Ingneniero Informático con más de <strong>{yearsOfExperience} años de experiencia</strong> en el sector del Desarrollo de Software.
            Durante ese tiempo he trabajado en <b>España</b> y en <b>México</b>, e incluso de forma remota para <b>USA</b>. Lo que me ha permitido conocer distintas culturas
            y Mercados.
          </p>
          <p class="mb-4">
            Lo que amo de mi profesión es poder construir soluciones a medida que permitan a mis colegas y clientes <b>ahorrar tiempo y dinero</b>. En lo personal
            encuentro muy gratificante cuando una persona me dice que mi solución le ha permitido trabajar mejor, tener más visibilidad de su negocio, le
            ha permitido trabajar de forma más eficiente o le ha ahorrado dinero.
          </p>
          <a href="/about" class="btn btn-outline-brand">Leer más</a>
        </div>
        <div class="col-lg-6">
          <div class="contact-card">
            <h3>Métodos de contacto</h3>
            <div class="contact-item">
              <span class="contact-label">Correo electrónico</span>
              <a href="mailto:contacto@mikelcantero.dev">contacto@mikelcantero.dev</a>
            </div>
            <div class="contact-item">
              <span class="contact-label">Whatsapp</span>
              <a href="https://wa.me/523326462099" target="_blank"><i class="fab fa-whatsapp me-1"></i>Escribir por WhatsApp</a>
            </div>
            <div class="contact-item">
              <span class="contact-label">Agenda una llamada</span>
              <a href={calendarLink} target="_blank" class="btn btn-brand btn-sm"><i class="fas fa-calendar-alt me-1"></i>Agenda una llamada</a>
            </div>
            <hr class="contact-divider" />
            <span class="contact-label mb-2 d-block">Redes</span>
            <div class="d-flex gap-2">
              {socialLinks.map((link) => (
                <a href={link.href} class="social-link" target="_blank" aria-label={link.icon.replace('fab fa-', '')} style="background: var(--border); color: var(--text-secondary); width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 10px; font-size: 18px; transition: all var(--transition);">
                  <i class={link.icon}></i>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Blog</span>
        <h2 class="section-title">Últimas publicaciones</h2>
        <p class="section-desc">Aquí encontrarás algunas de las publicaciones más recientes.</p>
      </div>
      <div class="row g-4 justify-content-center">
        {
          latestPosts.map((post) => {
            const imgSrc = typeof post.data.image === 'string' ? post.data.image : post.data.image?.src;
            return (
              <div class="col-md-6 col-lg-5">
                <div class="card-custom">
                  <div class="card-thumb">
                    <a href={"/blog/" + post.id}>
                      <img src={imgSrc || ""} alt={post.data.title} loading="lazy" />
                    </a>
                  </div>
                  <div class="card-body">
                    <h3 class="card-title">
                      <a href={"/blog/" + post.id}>{post.data.title}</a>
                    </h3>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
      <div class="text-center mt-5">
        <a href="/blog" class="btn btn-brand">Ver todos</a>
      </div>
    </div>
  </section>

  <!-- Brands -->
  <section class="section" style="background: var(--secondary);">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle" style="color: rgba(255,255,255,0.7);">Marcas reconocidas</span>
        <h2 class="section-title" style="color: #fff;">He trabajado con...</h2>
        <p class="section-desc" style="color: rgba(255,255,255,0.75);">Aquí encontrarás algunos de los clientes con los que he trabajado.</p>
      </div>
      <div id="brandsCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
          {[0, 4].map((start, idx) => (
            <div class={`carousel-item ${idx === 0 ? 'active' : ''}`}>
              <div class="row g-4 justify-content-center">
                {brands.slice(start, start + 4).map((brand) => (
                  <div class="col-6 col-md-3 brand-item">
                    <img src={brand.image} alt={brand.brand} loading="lazy" />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="d-flex justify-content-center gap-3 mt-4">
          <button class="btn btn-outline-light btn-sm rounded-circle" type="button" data-bs-target="#brandsCarousel" data-bs-slide="prev" aria-label="Anterior" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-chevron-left"></i>
          </button>
          <button class="btn btn-outline-light btn-sm rounded-circle" type="button" data-bs-target="#brandsCarousel" data-bs-slide="next" aria-label="Siguiente" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Testimonios</span>
        <h2 class="section-title">De mis clientes y compañeros</h2>
        <p class="section-desc">Aquí encontrarás algunos de los testimonios de mis clientes y compañeros.</p>
      </div>
      <div class="row g-4">
        {
          testimonials.map((t) => {
            const companyImgSrc = typeof t.data.companyImg === 'string' ? t.data.companyImg : t.data.companyImg?.src;
            const authorImgSrc = typeof t.data.img === 'string' ? t.data.img : t.data.img?.src;
            const MAX_LENGTH = 200;
            const needsTrim = t.data.testimonial.length > MAX_LENGTH;
            const shortText = needsTrim ? t.data.testimonial.substring(0, t.data.testimonial.lastIndexOf(' ', MAX_LENGTH)) + '...' : t.data.testimonial;

            return (
              <div class="col-lg-4">
                <div class="testimonial-card">
                  {companyImgSrc && <img src={companyImgSrc} alt={t.data.company || ""} class="company-img" loading="lazy" />}
                  <p class="testimonial-text">
                    <span class="testimonial-text-content" data-full={t.data.testimonial}>{shortText}</span>
                    {needsTrim && <button class="read-more-btn btn btn-sm btn-outline-brand mt-2" data-expanded="false">Ver más</button>}
                  </p>
                  <div class="author-info">
                    {authorImgSrc && <img src={authorImgSrc} alt={t.data.name} loading="lazy" />}
                    <div>
                      <span class="name">{t.data.name}</span>
                      <span class="role">{t.data.role}</span>
                    </div>
                  </div>
                </div>
                <ReviewRichSnippet name={t.data.name} role={t.data.role} company={t.data.company} avatar={authorImgSrc} testimonial={t.data.testimonial} service={t.data.service} />
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <span class="section-subtitle" style="color: var(--accent);">Trabajemos juntos</span>
      <h2>¿Necesitas ayuda con tu proyecto?</h2>
      <a href={calendarLink} target="_blank" class="btn btn-brand btn-lg">¡Hablemos!</a>
    </div>
  </section>
</AbstrakLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.read-more-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var textSpan = this.parentElement.querySelector('.testimonial-text-content');
        var expanded = this.getAttribute('data-expanded') === 'true';
        if (expanded) {
          var original = textSpan.getAttribute('data-original');
          textSpan.textContent = original || textSpan.textContent.substring(0, 200);
          this.textContent = 'Ver más';
          this.setAttribute('data-expanded', 'false');
        } else {
          if (!textSpan.getAttribute('data-original')) {
            textSpan.setAttribute('data-original', textSpan.textContent);
          }
          textSpan.textContent = textSpan.getAttribute('data-full');
          this.textContent = 'Ver menos';
          this.setAttribute('data-expanded', 'true');
        }
      });
    });
  });
</script>
