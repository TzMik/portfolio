---
import { filterByTag, getTags } from '../../lib/blog-posts.js';
import { PAGE_SIZE } from "../../lib/pagination.js";
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import "../../styles/ProjectLayout.css";

export async function getStaticPaths() {
  const allTags = await getTags();
  const paths = [];

  for (const tag of allTags) {
    const posts = await filterByTag(tag);
    const totalPages = Math.max(Math.ceil(posts.length / PAGE_SIZE), 1);
    
    for (let i = 1; i <= totalPages; i++) {
      paths.push({
        params: {
          tag: tag,
          page: i > 1 ? String(i) : undefined,
        },
      });
    }
  }

  return paths;
}

const { tag, page } = Astro.params;
const allPostsWithTag = await filterByTag(tag);
const currentPage = Number(page ?? "1");
const totalPages = Math.max(Math.ceil(allPostsWithTag.length / PAGE_SIZE), 1);
const start = (currentPage - 1) * PAGE_SIZE;
const items = allPostsWithTag.slice(start, start + PAGE_SIZE);

const pageUrl = (n) => `/tags/${tag}${n === 1 ? '' : `/${n}`}`;

---
<Layout>
  <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 container py-3 mt-5">
    <div class="section-header">
      <h1>Posts con la etiqueta: <span>{tag}</span></h1>
      <p class="description">
        Aquí puedes encontrar todas las publicaciones con la etiqueta: {tag}.
      </p>
    </div>
    <div class="row justify-content-center">
      {items.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>

  {totalPages > 1 && (
    <nav class="mt-8 d-flex flex-wrap align-items-center justify-content-center gap-2">
      {Array.from({ length: totalPages }, (_, i) => {
        const n = i + 1;
        return (
          <a
            href={pageUrl(n)}
            class={`rounded-md border px-3 py-1 text-sm ${n === currentPage ? "bg-black text-white" : ""}`}
          >
            {n}
          </a>
        );
      })}
    </nav>
  )}
</Layout>