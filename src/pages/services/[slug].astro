---
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import { getCollection } from "astro:content";
import type { ServiceSchema } from "../../content.config";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";
import { calendarLink } from "../../data/MainInformation";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

let testimonials = await getCollection("testimonials");
testimonials = testimonials.sort(() => Math.random() - 0.5);
testimonials = testimonials.slice(0, 3);

const { entry } = Astro.props;
const service: ServiceSchema = entry.data;
import { render } from "astro:content";
const { Content } = await render(entry);
---

<AbstrakLayout>
  <div class="page-header">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-minimal">
          <li class="breadcrumb-item"><a href="/">Inicio</a></li>
          <li class="breadcrumb-item"><a href="/services">Servicios</a></li>
          <li class="breadcrumb-item active">{service.title}</li>
        </ol>
      </nav>
      <div class="row align-items-center g-4">
        <div class="col-lg-6">
          <h1>{service.title}</h1>
          <p class="text-secondary fs-5">{service.description}</p>
          <a href={calendarLink} target="_blank" class="btn btn-brand mt-3">{service.cta || "Agendar llamada"}</a>
        </div>
        <div class="col-lg-6 text-center">
          {service.image && (
            <img
              src={typeof service.image === 'string' ? service.image : service.image?.src}
              alt={service.title}
              width="500"
              style="border-radius: var(--radius-lg); max-width: 100%;"
              loading="lazy"
            />
          )}
        </div>
      </div>
    </div>
  </div>

  <section class="section section-alt">
    <div class="container">
      <div class="row g-5">
        <div class="col-lg-8">
          <div class="post-content">
            <Content />
          </div>

          <!-- Testimonials -->
          {testimonials.length > 0 && (
            <div class="mt-5">
              <h3 class="section-title mb-4">Lo que dicen mis clientes</h3>
              <div class="row g-4">
                {testimonials.map((t) => {
                  const companyImgSrc = typeof t.data.companyImg === 'string' ? t.data.companyImg : t.data.companyImg?.src;
                  const authorImgSrc = typeof t.data.img === 'string' ? t.data.img : t.data.img?.src;
                  const MAX_LENGTH = 200;
                  const needsTrim = t.data.testimonial.length > MAX_LENGTH;
                  const shortText = needsTrim ? t.data.testimonial.substring(0, t.data.testimonial.lastIndexOf(' ', MAX_LENGTH)) + '...' : t.data.testimonial;

                  return (
                    <div class="col-md-6">
                      <div class="testimonial-card">
                        {companyImgSrc && <img src={companyImgSrc} alt={t.data.company || ""} class="company-img" loading="lazy" />}
                        <p class="testimonial-text">{shortText}</p>
                        <div class="author-info">
                          {authorImgSrc && <img src={authorImgSrc} alt={t.data.name} loading="lazy" />}
                          <div>
                            <span class="name">{t.data.name}</span>
                            <span class="role">{t.data.role}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>
        <div class="col-lg-4">
          <ContentSidebar />
        </div>
      </div>
    </div>
  </section>
</AbstrakLayout>
