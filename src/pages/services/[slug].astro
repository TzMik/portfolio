---
import { getCollection } from "astro:content";
import AbstrakLayout from "../../layouts/AbstrakLayout.astro";
import type { ServiceSchema } from "../../content/config";
import ContentSidebar from "../../components/abstrak/ContentSidebar.astro";
import "../../styles/AbstrakProjectLayout.css";
import { calendarLink } from "../../data/MainInformation";

export async function getStaticPaths() {
  const services = await getCollection("services");

  return services.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const service: ServiceSchema = entry.data;
const { Content } = await entry.render();
---

<AbstrakLayout
  title={service.title + " - Servicios | MikelCanteroDev"}
  description={service.description}
>
  <div class="breadcrum-area breadcrumb-banner">
    <div class="container">
      <div class="breadcrumb">
        <ul class="list-unstyled">
          <li><a href="/">Inicio</a></li>
          <li><a href="javascript:void(0);">Servicios</a></li>
          <li class="active">{service.title}</li>
        </ul>
      </div>
      <div class="section-heading heading-left">
        <h1 class="title h2">{service.title}</h1>
        <p>
          {service.description}
        </p>
      </div>
      <div class="banner-thumbnail">
        <img class="paralax-image" src={service.image} alt="Illustration" width="500" />
      </div>
    </div>
    <ul class="shape-group-8 list-unstyled">
      <li
        class="shape shape-1"
        data-sal="slide-right"
        data-sal-duration="500"
        data-sal-delay="100"
      >
        <img src="/abstrak/assets/media/others/bubble-9.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-2"
        data-sal="slide-left"
        data-sal-duration="500"
        data-sal-delay="200"
      >
        <img src="/abstrak/assets/media/others/bubble-21.png" alt="Bubble" />
      </li>
      <li
        class="shape shape-3"
        data-sal="slide-up"
        data-sal-duration="500"
        data-sal-delay="300"
      >
        <img src="/abstrak/assets/media/others/line-4.png" alt="Line" />
      </li>
    </ul>
  </div>
  <section class="section-padding">
    <div class="container">
      <div class="row row-40">
        <div class="col-lg-8">
            <div id="project-content">
                <Content />
            </div>
            <div class="d-flex justify-content-center">
                <div>
                    <a href={calendarLink} target="_blank" class="axil-btn btn-fill-primary">Agenda una llamada</a>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <ContentSidebar />
        </div>
      </div>
    </div>
  </section>
</AbstrakLayout>
